@model MedicalNewsVerifier.Web.ViewModels.AnalyzeResultViewModel

@{
    var record = Model.LastAnalysis!;
    var badgeClass = ReliabilityThresholds.StatusBadgeClass(record.ReliabilityScore);
    var statusLabel = ReliabilityThresholds.StatusLabel(record.ReliabilityScore);
    var llmSummary = record.LlmSummary ?? string.Empty;
    var corpusWeak = Model.OfficialMatches.Count == 0
        || llmSummary.Contains("insufficient_corpus", StringComparison.OrdinalIgnoreCase)
        || llmSummary.Contains("отсутствуют статист", StringComparison.OrdinalIgnoreCase)
        || llmSummary.Contains("не может быть подтвержден", StringComparison.OrdinalIgnoreCase)
        || (record.LlmAlignmentScore.HasValue && record.LlmAlignmentScore < 25);
}

<div class="card shadow-sm mb-3 border-@badgeClass">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <span class="badge bg-@badgeClass fs-6 px-3 py-2">@statusLabel</span>
            <div>
                <span class="text-muted small">Итог</span>
                <span class="fs-3 fw-bold ms-1">@record.ReliabilityScore/100</span>
            </div>
            <div class="small">
                <div>@AnalysisUiLabels.FeatureAnalysis: <strong>@record.HeuristicReliabilityScore/100</strong></div>
                <div>@AnalysisUiLabels.NeuralAnalysis: <strong>@(record.LlmAlignmentScore?.ToString() ?? "—")/100</strong></div>
            </div>
        </div>

        @if (corpusWeak)
        {
            <div class="alert alert-warning py-2 small mb-3">
                <strong>Согласованность с корпусом ограничена.</strong>
                @if (Model.OfficialMatches.Count == 0)
                {
                    <span> Релевантные официальные материалы не найдены — добавьте полные URL источников (https://…) в текст новости.</span>
                }
                else
                {
                    <span> Найденные материалы слабо связаны с темой; оценка нейросети опирается на общий контекст.</span>
                }
            </div>
        }

        @if (Model.OfficialMatches.Count > 0)
        {
            <div class="small">
                <div class="fw-semibold mb-1">Источники, использованные при проверке (@Model.OfficialMatches.Count)</div>
                <ul class="list-unstyled mb-0">
                    @foreach (var m in Model.OfficialMatches)
                    {
                        <li class="mb-1">
                            <span class="badge bg-@m.RelevanceBadgeClass me-1">@m.RelevanceLabel</span>
                            @m.SourceName — @m.Title
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
