@model bool

<div class="offcanvas offcanvas-end" tabindex="-1" id="analysisSettingsOffcanvas" aria-labelledby="analysisSettingsLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="analysisSettingsLabel">
            <i class="bi bi-sliders me-1"></i> Настройки анализа
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
    </div>
    <div class="offcanvas-body">
        <p class="small text-muted">Параметры действуют на текущую и следующие проверки в этом браузере. Серверные значения по умолчанию — из <code>appsettings.json</code>.</p>

        <form id="analysisSettingsForm" class="vstack gap-3">
            <div class="accordion accordion-flush" id="settingsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#settingsCorpus">
                            Корпус и источники
                        </button>
                    </h2>
                    <div id="settingsCorpus" class="accordion-collapse collapse show" data-bs-parent="#settingsAccordion">
                        <div class="accordion-body vstack gap-2">
                            <div>
                                <label class="form-label" for="setMaxArticles">Статей из источников (1–10)</label>
                                <input type="number" class="form-control form-control-sm" id="setMaxArticles" min="1" max="10" />
                            </div>
                            <div>
                                <label class="form-label" for="setMinRelevance">Порог релевантности (5–50)</label>
                                <input type="number" class="form-control form-control-sm" id="setMinRelevance" min="5" max="50" />
                            </div>
                            <div>
                                <label class="form-label" for="setMaxFeedScan">Скан ленты Минздрава (50–400)</label>
                                <input type="number" class="form-control form-control-sm" id="setMaxFeedScan" min="50" max="400" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#settingsOllama">
                            Нейросеть Ollama
                        </button>
                    </h2>
                    <div id="settingsOllama" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                        <div class="accordion-body vstack gap-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="setOllamaEnabled" @(Model ? "" : "disabled") />
                                <label class="form-check-label" for="setOllamaEnabled">Использовать нейросеть Ollama</label>
                            </div>
                            @if (!Model)
                            {
                                <div class="small text-warning">Ollama выключена глобально в конфигурации сервера.</div>
                            }
                            <div>
                                <label class="form-label" for="setMaxCorpusSnippets">Фрагментов корпуса для LLM (1–8)</label>
                                <input type="number" class="form-control form-control-sm" id="setMaxCorpusSnippets" min="1" max="8" />
                            </div>
                            <div>
                                <label class="form-label" for="setMaxCorpusChars">Символов на фрагмент (500–4000)</label>
                                <input type="number" class="form-control form-control-sm" id="setMaxCorpusChars" min="500" max="4000" step="100" />
                            </div>
                            <div>
                                <label class="form-label" for="setMaxResponseTokens">Токенов ответа (500–8000)</label>
                                <input type="number" class="form-control form-control-sm" id="setMaxResponseTokens" min="500" max="8000" step="100" />
                            </div>
                            <div>
                                <label class="form-label" for="setTemperature">Temperature (0–1.5)</label>
                                <input type="number" class="form-control form-control-sm" id="setTemperature" min="0" max="1.5" step="0.1" />
                            </div>
                            <div>
                                <label class="form-label" for="setTopP">TopP (0.1–1.0)</label>
                                <input type="number" class="form-control form-control-sm" id="setTopP" min="0.1" max="1" step="0.05" />
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="setEnableThinking" />
                                <label class="form-check-label" for="setEnableThinking">Режим thinking (Qwen3)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#settingsBlend">
                            Итоговая оценка
                        </button>
                    </h2>
                    <div id="settingsBlend" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                        <div class="accordion-body">
                            <label class="form-label" for="setFeatureBlend">Доля признакового анализа: <span id="setFeatureBlendValue">65</span>%</label>
                            <input type="range" class="form-range" id="setFeatureBlend" min="10" max="90" step="5" />
                            <div class="small text-muted">Нейросеть: <span id="setNeuralBlendValue">35</span>%</div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#settingsPython">
                            Python-модуль
                        </button>
                    </h2>
                    <div id="settingsPython" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                        <div class="accordion-body vstack gap-2">
                            <div>
                                <label class="form-label" for="setPythonTimeout">Таймаут (5–120 сек)</label>
                                <input type="number" class="form-control form-control-sm" id="setPythonTimeout" min="5" max="120" />
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="setPythonNatasha" />
                                <label class="form-check-label" for="setPythonNatasha">Natasha NER</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="setPythonStanza" />
                                <label class="form-check-label" for="setPythonStanza">Stanza NER</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <button type="button" class="btn btn-primary btn-sm" id="analysisSettingsApply">Применить</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="analysisSettingsReset">Сбросить к стандартным</button>
            </div>
        </form>
    </div>
</div>
