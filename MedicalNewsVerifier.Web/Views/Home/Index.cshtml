@model MedicalNewsVerifier.Web.ViewModels.AnalyzeResultViewModel
@{
    ViewData["Title"] = "Проверка новости";
    var ollamaOn = Model.OllamaEnabled;
}

<div class="page-header mb-4">
    <h1 class="page-title">Проверка медицинской новости</h1>
    <p class="page-subtitle text-muted mb-0">Признаковый анализ, корпус официальных источников и нейросеть Ollama</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div id="analysisProgressHost" class="app-card app-card-accent mb-3 d-none" aria-live="polite">
            <div class="app-card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                    <strong id="analysisProgressTitle">Анализ выполняется…</strong>
                </div>
                <div class="analysis-stepper mb-3" id="analysisStepper">
                    <div class="analysis-step" data-step="0"><span class="step-dot"></span><span class="step-label">Источники</span></div>
                    <div class="analysis-step" data-step="1"><span class="step-dot"></span><span class="step-label">@AnalysisUiLabels.FeatureAnalysisShort</span></div>
                    <div class="analysis-step" data-step="2"><span class="step-dot"></span><span class="step-label">@AnalysisUiLabels.NeuralAnalysisShort</span></div>
                    <div class="analysis-step" data-step="3"><span class="step-dot"></span><span class="step-label">Сохранение</span></div>
                </div>
                <p class="small text-muted mb-2" id="analysisProgressMessage">Подготовка…</p>
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="score-pill">
                            <div class="score-pill-label">@AnalysisUiLabels.FeatureAnalysisShort</div>
                            <div id="analysisHeuristicScore" class="score-pill-value">—</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="score-pill">
                            <div class="score-pill-label">@AnalysisUiLabels.NeuralAnalysisShort</div>
                            <div id="analysisLlmScore" class="score-pill-value">—</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="score-pill">
                            <div class="score-pill-label">Итог</div>
                            <div id="analysisCombinedScore" class="score-pill-value">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.LastAnalysis is not null)
        {
            <partial name="_AnalyzeFollowUpActions" model="false" />
        }

        <div class="app-card">
            <div class="app-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="fw-semibold">Текст для проверки</span>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span id="settingsModifiedBadge" class="badge bg-warning text-dark d-none">Настройки изменены</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#analysisSettingsOffcanvas">
                        <i class="bi bi-sliders"></i> Настройки
                    </button>
                </div>
            </div>
            <form id="newsAnalyzeForm" asp-action="Analyze" method="post" class="app-card-body">
                <div class="mb-3">
                    <label asp-for="Input.Headline" class="form-label"></label>
                    <input asp-for="Input.Headline" class="form-control" />
                    <span asp-validation-for="Input.Headline" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.NewsText" class="form-label"></label>
                    <textarea asp-for="Input.NewsText" class="form-control" rows="10" maxlength="15000"></textarea>
                    <span asp-validation-for="Input.NewsText" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.SourceUrl" class="form-label"></label>
                    <input asp-for="Input.SourceUrl" class="form-control" />
                    <span asp-validation-for="Input.SourceUrl" class="text-danger"></span>
                </div>
                @if (Model.LastAnalysis is null)
                {
                    <button type="submit" id="newsAnalyzeSubmit" class="btn btn-primary js-analysis-lockable" name="forceNew" value="false">
                        <i class="bi bi-play-fill me-1"></i> Запустить анализ
                    </button>
                }
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="app-card mb-3">
            <div class="app-card-body">
                <h6 class="fw-semibold mb-2"><i class="bi bi-info-circle me-1"></i> Как работает проверка</h6>
                <ol class="small text-muted ps-3 mb-0">
                    <li class="mb-1">Поиск релевантных материалов в официальных источниках</li>
                    <li class="mb-1">@AnalysisUiLabels.FeatureAnalysis (C# + Python)</li>
                    <li class="mb-1">@AnalysisUiLabels.NeuralAnalysis — сравнение с корпусом</li>
                    <li>Итоговая оценка и разметка текста</li>
                </ol>
            </div>
        </div>
        <div class="app-card">
            <div class="app-card-body">
                <h6 class="fw-semibold mb-2">Статус компонентов</h6>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge @(ollamaOn ? "bg-success" : "bg-secondary")">
                        Нейросеть Ollama: @(ollamaOn ? "вкл" : "выкл")
                    </span>
                </div>
                <a class="small" asp-controller="Home" asp-action="Diagnostics">Подробная диагностика →</a>
            </div>
        </div>
    </div>
</div>

<partial name="_AnalysisSettingsPanel" model="ollamaOn" />

@if (Model.LastAnalysis is not null)
{
    var featureGroups = FeatureInsightGrouping.BuildGroups(Model.LastAnalysis.SuspiciousFragments);
    var explanationLines = Model.LastAnalysis.Explanation
        .Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .ToList();

    <div class="row mt-4 g-4">
        <div class="col-12">
            @if (Model.OpenedFromHistory)
            {
                <div class="alert alert-info py-2">Просмотр сохранённой проверки из истории.</div>
            }
            else if (Model.IsFromHistory)
            {
                <div class="alert alert-info py-2">Совпадающая проверка уже выполнялась — показан сохранённый результат.</div>
            }

            <partial name="_AnalysisVerdictCard" model="Model" />

            <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-sm btn-outline-danger" asp-action="ExportPdf" asp-route-id="@Model.LastAnalysis.Id"><i class="bi bi-file-pdf me-1"></i>PDF</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="ExportJson" asp-route-id="@Model.LastAnalysis.Id"><i class="bi bi-filetype-json me-1"></i>JSON</a>
            </div>

            <div class="app-card mb-3">
                <div class="app-card-header fw-semibold">Подробный результат</div>
                <div class="app-card-body">
                    @{
                        var llmHasSummary = !string.IsNullOrWhiteSpace(Model.LastAnalysis.LlmSummary);
                        var llmHasResult = Model.LastAnalysis.LlmAlignmentScore.HasValue;
                        var llmSummaryBlockClass = llmHasResult ? "ollama-summary-block" : "ollama-summary-block ollama-summary-block--warning";
                    }
                    @if (llmHasSummary)
                    {
                        <div class="@llmSummaryBlockClass small mb-3">
                            <div class="fw-semibold mb-1">Краткое резюме (@AnalysisUiLabels.NeuralAnalysis)</div>
                            <div class="text-break mb-0">@Model.LastAnalysis.LlmSummary</div>
                        </div>
                    }
                    @if (explanationLines.Count == 0)
                    {
                        <p class="text-muted small mb-0">Пояснение отсутствует.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled analysis-summary mb-0">
                            @foreach (var line in explanationLines)
                            {
                                <li class="d-flex gap-3 px-3 py-2 border-bottom border-light small">
                                    <span class="text-secondary flex-shrink-0">—</span>
                                    <span class="text-break">@line</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="app-card mb-3">
                <div class="app-card-header fw-semibold">Разметка текста</div>
                <div class="app-card-body">
                    <p class="small text-muted mb-2">Наведите на блок признака справа — подсветятся фрагменты в тексте.</p>
                    <div class="markup-legend small mb-3 d-flex flex-wrap gap-3 align-items-center">
                        <span class="text-muted me-1">Легенда:</span>
                        @foreach (var sw in FeatureKindMetadata.LegendSwatches())
                        {
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="markup-legend-swatch marker-kind-@sw.CssToken"></span>
                                <span>@sw.Label</span>
                            </span>
                        }
                    </div>
                    <div class="row g-3" data-analysis-markup>
                        <div class="col-lg-7">
                            <div class="text-markup-host">@Html.Raw(Model.HighlightedHtml ?? string.Empty)</div>
                        </div>
                        <div class="col-lg-5">
                            @if (featureGroups.Count == 0)
                            {
                                <p class="text-muted mb-0">Записей разметки нет.</p>
                            }
                            else
                            {
                                @foreach (var g in featureGroups)
                                {
                                    var kinds = string.Join(",", g.KindValues);
                                    <div class="feature-hint border rounded p-2 mb-2" data-feature-hints="@kinds">
                                        <div class="fw-semibold">@g.Title</div>
                                        <div class="small text-muted mt-1">@g.Description</div>
                                        <div class="small mt-2">Найдено: <strong>@g.Fragments.Count</strong></div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-card mb-3">
                <div class="app-card-header fw-semibold">Релевантные официальные публикации</div>
                <div class="app-card-body">
                    @if (Model.OfficialMatches.Count == 0)
                    {
                        <div class="alert alert-light border small mb-0">
                            <p class="mb-2">Совпадения не найдены. Добавьте URL источников (<code>https://</code>) в текст новости.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var source in Model.OfficialMatches)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div><strong>@source.SourceName</strong>: @source.Title</div>
                                        <a href="@source.Url" target="_blank" rel="noopener" class="small">@source.Url</a>
                                    </div>
                                    <span class="badge bg-@source.RelevanceBadgeClass">@source.RelevanceLabel (@source.RelevanceScore%)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <partial name="_AnalyzeFollowUpActions" model="true" />
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.LastAnalysis is not null)
    {
        <script src="~/js/analysis-markup.js" asp-append-version="true"></script>
    }
    @{
        var analysisStartUrl = Url.Action("Start", "AnalysisApi") ?? "";
        var analysisDefaultsUrl = Url.Action("Defaults", "AnalysisApi") ?? "";
        var statusJobPlaceholder = Guid.Parse("00000000-0000-0000-0000-000000000001");
        var analysisStatusUrlTemplate = Url.Action("Status", "AnalysisApi", new { jobId = statusJobPlaceholder }) ?? "";
        const int detailsIdPlaceholder = 123456789;
        var detailsUrlTemplate = Url.Action("Details", "Home", new { id = detailsIdPlaceholder }) ?? "";
    }
    <script>
        window.__analysisPageConfig = {
            startUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analysisStartUrl)),
            defaultsUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analysisDefaultsUrl)),
            statusUrlTemplate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analysisStatusUrlTemplate)),
            detailsUrlTemplate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(detailsUrlTemplate)),
            statusJobPlaceholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusJobPlaceholder.ToString("D"))),
            detailsIdPlaceholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(detailsIdPlaceholder.ToString(System.Globalization.CultureInfo.InvariantCulture)))
        };
    </script>
    <script src="~/js/analysis-page.js" asp-append-version="true"></script>
}
