@model MedicalNewsVerifier.Web.ViewModels.AnalyzeResultViewModel
@{
    ViewData["Title"] = "Проверка новости";
    var ollamaOn = Model.OllamaEnabled;
}

<div class="row">
    <div class="col-lg-10">
        <h2 class="mb-1">Первичная проверка достоверности медицинской новости</h2>
        <p class="text-muted small mb-3">MedNews Verifier — проверка текстов медицинских новостей</p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge @(ollamaOn ? "bg-success" : "bg-secondary")">
                Ollama: @(ollamaOn ? "включена" : "выключена")
            </span>
            <a class="small" asp-controller="Home" asp-action="Diagnostics">Статус системы</a>
        </div>
        <div class="alert alert-secondary">
            Анализ учитывает лексические, пунктуационные и структурные признаки (C#), дополнительный модуль Python,
            совпадения с корпусом доверенных материалов и параллельно — сравнение с тем же корпусом через локальную модель
            <strong>Ollama</strong>. Ход анализа отображается ниже по мере готовности этапов.
        </div>
        <div id="analysisProgressHost" class="card border-primary mb-3 shadow-sm d-none" aria-live="polite">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                    <strong id="analysisProgressTitle">Анализ выполняется…</strong>
                </div>
                <div class="analysis-stepper mb-3" id="analysisStepper">
                    <div class="analysis-step" data-step="0"><span class="step-dot"></span><span class="step-label">Источники</span></div>
                    <div class="analysis-step" data-step="1"><span class="step-dot"></span><span class="step-label">Эвристика</span></div>
                    <div class="analysis-step" data-step="2"><span class="step-dot"></span><span class="step-label">Ollama</span></div>
                    <div class="analysis-step" data-step="3"><span class="step-dot"></span><span class="step-label">Сохранение</span></div>
                </div>
                <p class="small text-muted mb-2" id="analysisProgressMessage">Подготовка…</p>
                <div class="row g-2 small">
                    <div class="col-md-4">
                        <div class="border rounded p-2 bg-light">
                            <div class="text-muted">Эвристика</div>
                            <div id="analysisHeuristicScore" class="fs-5">—</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 bg-light">
                            <div class="text-muted">Ollama (LLM)</div>
                            <div id="analysisLlmScore" class="fs-5">—</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 bg-light">
                            <div class="text-muted">Итог</div>
                            <div id="analysisCombinedScore" class="fs-5">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.LastAnalysis is not null)
        {
            <partial name="_AnalyzeFollowUpActions" model="false" />
        }
        <form id="newsAnalyzeForm" asp-action="Analyze" method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Input.Headline" class="form-label"></label>
                <input asp-for="Input.Headline" class="form-control" />
                <span asp-validation-for="Input.Headline" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.NewsText" class="form-label"></label>
                <textarea asp-for="Input.NewsText" class="form-control" rows="8" maxlength="15000"></textarea>
                <span asp-validation-for="Input.NewsText" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.SourceUrl" class="form-label"></label>
                <input asp-for="Input.SourceUrl" class="form-control" />
                <span asp-validation-for="Input.SourceUrl" class="text-danger"></span>
            </div>
            @if (Model.LastAnalysis is null)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button type="submit" id="newsAnalyzeSubmit" class="btn btn-primary js-analysis-lockable" name="forceNew" value="false">Запустить анализ</button>
                </div>
            }
        </form>
    </div>
</div>

@if (Model.LastAnalysis is not null)
{
    var featureGroups = FeatureInsightGrouping.BuildGroups(Model.LastAnalysis.SuspiciousFragments);
    var explanationLines = Model.LastAnalysis.Explanation
        .Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .ToList();

    <div class="row mt-4">
        <div class="col-lg-10">
            @if (Model.OpenedFromHistory)
            {
                <div class="alert alert-info py-2">
                    Просмотр сохранённой проверки из истории: оценка, разметка и расшифровка признаков восстановлены из базы данных.
                </div>
            }
            else if (Model.IsFromHistory)
            {
                <div class="alert alert-info py-2">
                    Совпадающая проверка уже выполнялась ранее. Показан сохранённый результат и разметка из истории.
                </div>
            }

            <partial name="_AnalysisVerdictCard" model="Model" />

            <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-sm btn-outline-danger" asp-action="ExportPdf" asp-route-id="@Model.LastAnalysis.Id">Скачать PDF</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="ExportJson" asp-route-id="@Model.LastAnalysis.Id">Скачать JSON</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3">Подробный результат</h4>
                    <div class="mb-0">
                        <div class="fw-semibold mb-2">Сводка автоматического анализа</div>
                        @{
                            var llmHasSummary = !string.IsNullOrWhiteSpace(Model.LastAnalysis.LlmSummary);
                            var llmHasResult = Model.LastAnalysis.LlmAlignmentScore.HasValue;
                            var llmSummaryBlockClass = llmHasResult
                                ? "ollama-summary-block"
                                : "ollama-summary-block ollama-summary-block--warning";
                        }
                        @if (llmHasSummary)
                        {
                            <div class="@llmSummaryBlockClass small mb-3">
                                <div class="fw-semibold mb-1">Краткое резюме модели (Ollama)</div>
                                <div class="text-break mb-0">@Model.LastAnalysis.LlmSummary</div>
                            </div>
                        }
                        @if (explanationLines.Count == 0)
                        {
                            <p class="text-muted small mb-0">Пояснение отсутствует.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled analysis-summary border rounded-3 overflow-hidden mb-0">
                                @foreach (var line in explanationLines)
                                {
                                    <li class="d-flex gap-3 px-3 py-2 border-bottom border-light small">
                                        <span class="text-secondary flex-shrink-0">—</span>
                                        <span class="text-break">@line</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-2">Разметка текста</h5>
                    <p class="small text-muted mb-2">
                        Заголовок выделен жирным; ниже — текст новости. Наведите указатель на блок признака справа —
                        подсветятся и текст, и сам блок.
                    </p>
                    <div class="markup-legend small mb-3 d-flex flex-wrap gap-3 align-items-center">
                        <span class="text-muted me-1">Легенда:</span>
                        @foreach (var sw in FeatureKindMetadata.LegendSwatches())
                        {
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="markup-legend-swatch marker-kind-@sw.CssToken" title="@sw.Label"></span>
                                <span>@sw.Label</span>
                            </span>
                        }
                    </div>
                    <div class="row g-3" data-analysis-markup>
                        <div class="col-lg-7">
                            <div class="text-markup-host" aria-label="Текст с подсветкой признаков">
                                @Html.Raw(Model.HighlightedHtml ?? string.Empty)
                            </div>
                        </div>
                        <div class="col-lg-5">
                            @if (featureGroups.Count == 0)
                            {
                                <p class="text-muted mb-0">Записей разметки с типом признака нет (возможна старая запись до обновления схемы).</p>
                            }
                            else
                            {
                                @foreach (var g in featureGroups)
                                {
                                    var kinds = string.Join(",", g.KindValues);
                                    var samples = g.Fragments
                                        .Select(f => f.FragmentText)
                                        .Where(t => !string.IsNullOrWhiteSpace(t))
                                        .Distinct()
                                        .Take(4)
                                        .ToList();
                                    <div class="feature-hint border rounded p-2 mb-2" data-feature-hints="@kinds">
                                        <div class="fw-semibold">@g.Title</div>
                                        <div class="small text-muted mt-1">@g.Description</div>
                                        <div class="small mt-2">
                                            <span class="text-muted">Найдено вхождений:</span> <strong>@g.Fragments.Count</strong>
                                        </div>
                                        @if (samples.Count > 0)
                                        {
                                            <div class="small mt-1 text-break">
                                                <span class="text-muted">Примеры:</span>
                                                @string.Join(" · ", samples.Select(s => s.Length > 80 ? s[..77] + "…" : s))
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Релевантные официальные публикации</h5>
                    @if (Model.OfficialMatches.Count == 0)
                    {
                        <div class="alert alert-light border small mb-0">
                            <p class="mb-2">Совпадения с официальными источниками не найдены. Чтобы улучшить проверку:</p>
                            <ul class="mb-0">
                                <li>Укажите полные URL официальных источников в тексте новости (с префиксом <code>https://</code>).</li>
                                <li>Добавьте ключевые слова темы (онкология, ОРВИ, статистика и т.д.).</li>
                                <li>Проверьте, что в разделе «Корпус» есть материалы по вашей теме.</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var source in Model.OfficialMatches)
                            {
                                var relClass = source.RelevanceScore >= 40 ? "success" : source.RelevanceScore >= 22 ? "warning" : "secondary";
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div><strong>@source.SourceName</strong>: @source.Title</div>
                                        <a href="@source.Url" target="_blank" rel="noopener">@source.Url</a>
                                    </div>
                                    <span class="badge bg-@relClass"
                                          title="Совпадение по ключевым словам и теме новости">@source.RelevanceScore%</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-lg-10">
            <partial name="_AnalyzeFollowUpActions" model="true" />
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.LastAnalysis is not null)
    {
        <script src="~/js/analysis-markup.js" asp-append-version="true"></script>
    }
    @{
        var analysisStartUrl = Url.Action("Start", "AnalysisApi") ?? "";
        var statusJobPlaceholder = Guid.Parse("00000000-0000-0000-0000-000000000001");
        var analysisStatusUrlTemplate = Url.Action("Status", "AnalysisApi", new { jobId = statusJobPlaceholder }) ?? "";
        const int detailsIdPlaceholder = 123456789;
        var detailsUrlTemplate = Url.Action("Details", "Home", new { id = detailsIdPlaceholder }) ?? "";
        var jso = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
        var analysisStartJson = System.Text.Json.JsonSerializer.Serialize(analysisStartUrl, jso);
        var analysisStatusJson = System.Text.Json.JsonSerializer.Serialize(analysisStatusUrlTemplate, jso);
        var detailsUrlJson = System.Text.Json.JsonSerializer.Serialize(detailsUrlTemplate, jso);
        var statusPlaceholderJson = System.Text.Json.JsonSerializer.Serialize(statusJobPlaceholder.ToString("D"), jso);
        var detailsPlaceholderJson = System.Text.Json.JsonSerializer.Serialize(detailsIdPlaceholder.ToString(System.Globalization.CultureInfo.InvariantCulture), jso);
    }
    <script>
        (function () {
            const analysisStartUrl = @Html.Raw(analysisStartJson);
            const analysisStatusUrlTemplate = @Html.Raw(analysisStatusJson);
            const detailsUrlTemplate = @Html.Raw(detailsUrlJson);
            const statusJobPlaceholder = @Html.Raw(statusPlaceholderJson);
            const detailsIdPlaceholder = @Html.Raw(detailsPlaceholderJson);
            const form = document.getElementById('newsAnalyzeForm');
            const host = document.getElementById('analysisProgressHost');
            const msg = document.getElementById('analysisProgressMessage');
            const hScore = document.getElementById('analysisHeuristicScore');
            const lScore = document.getElementById('analysisLlmScore');
            const cScore = document.getElementById('analysisCombinedScore');
            const lockableButtons = Array.from(document.querySelectorAll('.js-analysis-lockable'));
            const lockableNav = Array.from(document.querySelectorAll('.js-analysis-lockable-nav, .navbar a, a.nav-link'));
            let analysisRunning = false;
            if (!form || !host || !analysisStartUrl) return;
            const formControls = Array.from(form.querySelectorAll('input, textarea, select, button'));

            function statusUrl(jobId) {
                return analysisStatusUrlTemplate.replace(statusJobPlaceholder, jobId);
            }
            function detailsUrl(id) {
                return detailsUrlTemplate.replace(detailsIdPlaceholder, String(id));
            }

            function setUiLocked(isLocked) {
                lockableButtons.forEach((btn) => {
                    btn.disabled = isLocked;
                    btn.setAttribute('aria-disabled', isLocked ? 'true' : 'false');
                });
                formControls.forEach((control) => {
                    if (isLocked) {
                        control.setAttribute('data-analysis-was-disabled', control.disabled ? '1' : '0');
                        control.disabled = true;
                    } else {
                        const wasDisabled = control.getAttribute('data-analysis-was-disabled') === '1';
                        control.disabled = wasDisabled;
                        control.removeAttribute('data-analysis-was-disabled');
                    }
                });
                lockableNav.forEach((link) => {
                    link.style.pointerEvents = isLocked ? 'none' : '';
                    link.style.opacity = isLocked ? '0.55' : '';
                    link.setAttribute('aria-disabled', isLocked ? 'true' : 'false');
                    if (isLocked) {
                        link.setAttribute('tabindex', '-1');
                    } else {
                        link.removeAttribute('tabindex');
                    }
                });
            }

            function updateStepper(stepIndex) {
                const steps = document.querySelectorAll('#analysisStepper .analysis-step');
                steps.forEach((el) => {
                    const idx = parseInt(el.getAttribute('data-step') || '0', 10);
                    el.classList.toggle('is-active', idx === stepIndex);
                    el.classList.toggle('is-done', idx < stepIndex);
                });
            }

            function updateProgressUi(state) {
                const phase = state?.phase ?? '';
                const stepIndex = typeof state?.stepIndex === 'number'
                    ? state.stepIndex
                    : phase === 'LoadingSources' ? 0
                    : phase === 'RunningAnalyzers' || phase === 'HeuristicReady' ? 1
                    : phase === 'LlmReady' ? 2
                    : phase === 'Combining' ? 3
                    : phase === 'Completed' ? 4
                    : 0;
                updateStepper(Math.min(stepIndex, 3));

                const hasHeuristic = typeof state?.heuristicScore === 'number';
                const hasLlm = typeof state?.llmScore === 'number';
                const hasCombined = typeof state?.combinedScore === 'number';

                hScore.textContent = hasHeuristic
                    ? state.heuristicScore + '/100'
                    : 'Выполняется…';
                lScore.textContent = hasLlm
                    ? state.llmScore + '/100'
                    : hasHeuristic
                        ? 'Нейросетевой этап в работе…'
                        : 'Ожидание…';
                cScore.textContent = hasCombined
                    ? state.combinedScore + '/100'
                    : hasHeuristic
                        ? 'Формируется итог…'
                        : 'Ожидание…';

                if (phase === 'HeuristicReady') {
                    msg.textContent = 'Первичный (эвристический + Python) анализ уже готов. Нейросетевой этап продолжается…';
                } else if (phase === 'LlmReady') {
                    msg.textContent = 'Нейросетевой этап завершён. Формируется итоговый вывод…';
                } else if (state?.message) {
                    msg.textContent = state.message;
                }
            }

            form.addEventListener('submit', async function (e) {
                const submitter = e.submitter;
                e.preventDefault();
                if (analysisRunning) {
                    msg.classList.remove('text-danger');
                    msg.textContent = 'Проверка уже выполняется. Дождитесь завершения текущего запуска.';
                    return;
                }
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                analysisRunning = true;
                setUiLocked(true);

                host.classList.remove('d-none');
                updateStepper(0);
                msg.textContent = 'Отправка запроса…';
                msg.classList.remove('text-danger');
                hScore.textContent = 'Ожидание…';
                lScore.textContent = 'Ожидание…';
                cScore.textContent = 'Ожидание…';

                const payload = {
                    headline: document.querySelector('[name="Input.Headline"]')?.value ?? '',
                    newsText: document.querySelector('[name="Input.NewsText"]')?.value ?? '',
                    forceNew: submitter && submitter.getAttribute('name') === 'forceNew' && submitter.value === 'true',
                    sourceUrl: (() => {
                        const v = document.querySelector('[name="Input.SourceUrl"]')?.value?.trim() ?? '';
                        return v === '' ? null : v;
                    })()
                };

                const startResp = await fetch(analysisStartUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!startResp.ok) {
                    let detail = 'HTTP ' + startResp.status;
                    try {
                        const errBody = await startResp.json();
                        if (errBody.errors && typeof errBody.errors === 'object') {
                            const lines = [];
                            for (const key of Object.keys(errBody.errors)) {
                                const arr = errBody.errors[key];
                                if (Array.isArray(arr)) {
                                    for (const line of arr) {
                                        lines.push(line);
                                    }
                                }
                            }
                            if (lines.length) {
                                detail = lines.join(' ');
                            }
                        } else if (typeof errBody.message === 'string' && errBody.message) {
                            detail = errBody.message;
                        } else if (typeof errBody.title === 'string' && errBody.title) {
                            detail = errBody.title;
                        }
                    } catch {
                        /* ignore */
                    }
                    msg.classList.add('text-danger');
                    msg.textContent = 'Не удалось запустить анализ: ' + detail;
                    analysisRunning = false;
                    setUiLocked(false);
                    return;
                }

                const startJson = await startResp.json();
                const jobId = startJson.jobId;
                if (!jobId) {
                    msg.classList.add('text-danger');
                    msg.textContent = 'Сервер не вернул идентификатор задания.';
                    analysisRunning = false;
                    setUiLocked(false);
                    return;
                }
                msg.textContent = 'Анализ запущен, ожидайте этапы…';

                const timer = setInterval(async () => {
                    const st = await fetch(statusUrl(jobId), { headers: { 'Accept': 'application/json' } });
                    if (!st.ok) {
                        clearInterval(timer);
                        msg.textContent = 'Статус анализа недоступен (HTTP ' + st.status + ').';
                        analysisRunning = false;
                        setUiLocked(false);
                        return;
                    }
                    const s = await st.json();
                    updateProgressUi(s);

                    if (s.phase === 'Completed') {
                        clearInterval(timer);
                        analysisRunning = false;
                        if (s.recordId) {
                            window.location.href = detailsUrl(s.recordId);
                        } else {
                            setUiLocked(false);
                        }
                    }
                    if (s.phase === 'Failed') {
                        clearInterval(timer);
                        msg.textContent = 'Ошибка: ' + (s.error || 'неизвестно');
                        analysisRunning = false;
                        setUiLocked(false);
                    }
                }, 450);
            });
        })();
    </script>
}
