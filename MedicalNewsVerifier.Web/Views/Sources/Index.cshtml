@model MedicalNewsVerifier.Web.ViewModels.SourcesPageViewModel
@{
    ViewData["Title"] = "Доверенные источники";
}

<div class="row">
    <div class="col-lg-10">
        <h2 class="mb-3">Справочник доверенных источников</h2>
        <p class="text-muted small">
            Каталог URL для библиографии и ориентира. Сопоставление новости с текстами выполняется по записям в разделе
            <a asp-controller="Corpus" asp-action="Index">корпус материалов</a>.
        </p>
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success py-2">@msg</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger py-2">@err</div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header">Добавить источник</div>
            <div class="card-body">
                <form asp-action="Add" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-2">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.BaseUrl" class="form-label"></label>
                        <input asp-for="Input.BaseUrl" class="form-control" />
                        <span asp-validation-for="Input.BaseUrl" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.AccessedOnUtc" class="form-label"></label>
                        <input asp-for="Input.AccessedOnUtc" class="form-control" />
                        <span asp-validation-for="Input.AccessedOnUtc" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="Input.IsEnabled" class="form-check-input" />
                        <label asp-for="Input.IsEnabled" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Порядок</th>
                        <th>Название</th>
                        <th>URL</th>
                        <th>Дата обращения</th>
                        <th>Вкл.</th>
                        <th style="width: 11rem;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td>@s.SortOrder</td>
                            <td>@s.Name</td>
                            <td><a href="@s.BaseUrl" target="_blank" rel="noopener">@s.BaseUrl</a></td>
                            <td>@(s.AccessedOnUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>
                                <form asp-action="SetEnabled" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <div class="form-check mb-0">
                                        <input type="checkbox" name="enabled" value="true" class="form-check-input"
                                               checked="@s.IsEnabled" onchange="this.form.submit()" title="Включить или отключить источник" />
                                    </div>
                                </form>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary btn-edit-source"
                                        data-id="@s.Id"
                                        data-name="@s.Name"
                                        data-base-url="@s.BaseUrl"
                                        data-accessed="@(s.AccessedOnUtc?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                        data-enabled="@s.IsEnabled.ToString().ToLowerInvariant()"
                                        data-sort-order="@s.SortOrder">
                                    Изменить
                                </button>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Удалить источник «@s.Name»?');">
                                        Удалить
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editSourceModal" tabindex="-1" aria-labelledby="editSourceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editSourceModalLabel">Редактировать источник</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <input type="hidden" asp-for="Edit.Id" id="edit-source-id" />
                    <div class="mb-2">
                        <label asp-for="Edit.Name" class="form-label"></label>
                        <input asp-for="Edit.Name" class="form-control" id="edit-source-name" />
                        <span asp-validation-for="Edit.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Edit.BaseUrl" class="form-label"></label>
                        <input asp-for="Edit.BaseUrl" class="form-control" id="edit-source-base-url" />
                        <span asp-validation-for="Edit.BaseUrl" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Edit.AccessedOnUtc" class="form-label"></label>
                        <input asp-for="Edit.AccessedOnUtc" class="form-control" id="edit-source-accessed" />
                        <span asp-validation-for="Edit.AccessedOnUtc" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Edit.SortOrder" class="form-label"></label>
                        <input asp-for="Edit.SortOrder" class="form-control" id="edit-source-sort-order" type="number" />
                        <span asp-validation-for="Edit.SortOrder" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="Edit.IsEnabled" class="form-check-input" id="edit-source-enabled" />
                        <label asp-for="Edit.IsEnabled" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const modalEl = document.getElementById('editSourceModal');
            if (!modalEl) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            document.querySelectorAll('.btn-edit-source').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('edit-source-id').value = btn.dataset.id;
                    document.getElementById('edit-source-name').value = btn.dataset.name;
                    document.getElementById('edit-source-base-url').value = btn.dataset.baseUrl;
                    document.getElementById('edit-source-accessed').value = btn.dataset.accessed || '';
                    document.getElementById('edit-source-sort-order').value = btn.dataset.sortOrder;
                    document.getElementById('edit-source-enabled').checked = btn.dataset.enabled === 'true';
                    modal.show();
                });
            });

            @if (Model.Edit is not null)
            {
                <text>
                document.getElementById('edit-source-id').value = '@Model.Edit.Id';
                document.getElementById('edit-source-name').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Edit.Name));
                document.getElementById('edit-source-base-url').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Edit.BaseUrl));
                document.getElementById('edit-source-accessed').value = '@(Model.Edit.AccessedOnUtc?.ToString("yyyy-MM-ddTHH:mm") ?? "")';
                document.getElementById('edit-source-sort-order').value = '@Model.Edit.SortOrder';
                document.getElementById('edit-source-enabled').checked = @(Model.Edit.IsEnabled ? "true" : "false");
                modal.show();
                </text>
            }
        })();
    </script>
}
