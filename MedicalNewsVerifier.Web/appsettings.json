{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=mednews_mvp;Username=postgres;Password=postgres"
  },
  "Python": {
    "ExecutablePath": "python",
    "ScriptPath": "python/analyze_text.py",
    "TimeoutSeconds": 30,
    "LexiconRoot": "Resources/Lexicons",
    "EnableNatasha": false,
    "EnableStanza": false
  },
  "OfficialSources": {
    "TimeoutSeconds": 30,
    "Urls": [
      "https://minzdrav.gov.ru/",
      "https://grls.rosminzdrav.ru/Default.aspx",
      "https://cgon.rospotrebnadzor.ru/"
    ]
  },
  "SourceParsers": {
    "TimeoutSeconds": 30,
    "MaxArticlesPerAnalysis": 5,
    "MinRelevanceScore": 15,
    "StatisticsUrls": [
      "https://fedstat.ru/indicator/41715"
    ],
    "Minzdrav": {
      "FeedUrl": "https://minzdrav.gov.ru/news.atom",
      "MaxFeedScan": 400
    },
    "Rospotrebnadzor": {
      "RecommendationsUrl": "https://cgon.rospotrebnadzor.ru/naseleniyu/zdorovyy-obraz-zhizni/rekomendatsii-naseleniyu-v-period-podema-zabolevaemosti-grippom-i-orvi/"
    }
  },
  "AnalysisLexicons": {
    "BasePath": "Resources/Lexicons",
    "EmotionalFile": "emotional_ru.txt",
    "ManipulativeFile": "manipulative_ru.txt",
    "EvaluativeFile": "evaluative_ru.txt",
    "SourceCuesFile": "source_cues_ru.txt"
  },
  "AnalysisScoring": {
    "WeightsFile": "Resources/Scoring/feature_weights.json",
    "HeuristicBlendWeight": 0.65,
    "LlmBlendWeight": 0.35
  },
  "Ollama": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434/v1",
    "Model": "qwen3.5:9b",
    "TimeoutSeconds": 300,
    "MaxCorpusSnippets": 4,
    "MaxCorpusCharsPerSnippet": 1200,
    "MaxResponseTokens": 3000,
    "Temperature": 0.2,
    "TopP": 1.0,
    "EnableThinking": false,
    "PreferNativeApi": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
